{
    "name": "@local/dsh-file-tracker",
    "version": "1.0.1",
    "private": true,
    "type": "module",
    "description": "Tracks every file the AI creates, modifies, deletes, renames, or moves, and shows it in a floating live panel.",
    "exports": {
        ".": "./index.js",
        "./client": "./client.js",
        "./locale/*.json": "./locale/*.json",
        "./icon": "./icon.svg"
    },
    "files": [
        "index.js",
        "client.js",
        "cordis.patch.yml",
        "locale/*.json",
        "icon.svg"
    ],
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "immediately": true,
            "inject": [
                "@deepseek-ai/dsh-client-locale",
                "@deepseek-ai/dsh-client-ui-layout",
                "@deepseek-ai/dsh-client-ui-conversation"
            ]
        }
    }
}